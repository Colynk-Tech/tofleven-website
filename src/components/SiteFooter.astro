---
import {
	content,
	getPath,
	legalDocumentUrls,
	type Locale,
} from "../lib/content";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const shared = content[locale].shared;
const footer = shared.footer;
const home = content[locale].pages.home;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-registrations">
		<div
			class="shell footer-registrations__inner"
			aria-label={locale === "nl" ? "Beroepsregistraties" : "Professional registrations"}
		>
			<p>{locale === "nl" ? "Beroepsregistraties" : "Professional registrations"}</p>
			<div class="footer-registration-logos">
				<img
					class="footer-registration-logo footer-registration-logo--eft"
					src="/images/registrations/eft-logo.png"
					alt="EFT – samen voor betere relaties"
					width="300"
					height="100"
					loading="lazy"
					decoding="async"
				/>
				<span aria-hidden="true"></span>
				<img
					class="footer-registration-logo footer-registration-logo--skj"
					src="/images/registrations/skj-logo.png"
					alt="SKJ Kwaliteitsregister Jeugd"
					width="270"
					height="150"
					loading="lazy"
					decoding="async"
				/>
			</div>
		</div>
	</div>

	<div class="shell footer-inner">
		<div class="footer-brand">
			<span class="footer-brand__name">Tofleven</span>
			<p>{home.hero.title}</p>
		</div>

		<nav class="footer-column" aria-labelledby={`footer-about-${locale}`}>
			<h2 id={`footer-about-${locale}`}>{footer.col1Title}</h2>
			<ul>
				<li><a href={getPath(locale, "about")}>{footer.col1Items[0]}</a></li>
				<li><a href={getPath(locale, "accountability")}>{footer.col1Items[1]}</a></li>
			</ul>
		</nav>

		<div class="footer-column" aria-labelledby={`footer-contact-${locale}`}>
			<h2 id={`footer-contact-${locale}`}>{footer.col2Title}</h2>
			<ul>
				<li>{footer.locationLabel}</li>
			</ul>
		</div>
	</div>

	<div class="shell footer-bottom">
		<span>© {currentYear} Tofleven</span>
		<nav
			class="footer-legal-links"
			aria-label={locale === "nl" ? "Juridische documenten" : "Legal documents"}
		>
			<a
				href={legalDocumentUrls.terms[locale]}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`${footer.termsLink} (${footer.opensNewTabLabel})`}
			>{footer.termsLink}</a>
			<a
				href={legalDocumentUrls.privacy[locale]}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`${footer.privacyLink} (${footer.opensNewTabLabel})`}
			>{footer.privacyLink}</a>
			<a
				href={legalDocumentUrls.disclaimer}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={`${footer.disclaimerLink} (${footer.opensNewTabLabel})`}
			>{footer.disclaimerLink}</a>
		</nav>
	</div>
</footer>
