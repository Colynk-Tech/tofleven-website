---
interface Props {
	href: string;
	variant?: "primary" | "secondary" | "ghost";
	size?: "default" | "large";
}

const { href, variant = "primary", size = "default" } = Astro.props;
---

<a
	href={href}
	class:list={[
		"button",
		`button--${variant}`,
		size === "large" && "button--large",
	]}
>
	<slot />
</a>
