---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
	content,
	getPath,
	getSeo,
	type Locale,
	type PageKey,
} from "../lib/content";
import "../styles/global.css";

interface Props {
	locale: Locale;
	page: PageKey;
	titleOverride?: string;
	descriptionOverride?: string;
	noindex?: boolean;
}

const {
	locale,
	page,
	titleOverride,
	descriptionOverride,
	noindex = false,
} = Astro.props;
const shared = content[locale].shared;
const defaultSeo = getSeo(locale, page);
const pageSeo = {
	title: titleOverride ?? defaultSeo.title,
	description: descriptionOverride ?? defaultSeo.description,
};
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(getPath(locale, page), siteBase);
const nlUrl = new URL(getPath("nl", page), siteBase);
const enUrl = new URL(getPath("en", page), siteBase);
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Tofleven",
	url: new URL("/", siteBase).toString(),
	inLanguage: ["nl", "en"],
};
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f7f3ec" />
		<meta name="color-scheme" content="light" />
		<meta name="description" content={pageSeo.description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<title>{pageSeo.title}</title>
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="nl" href={nlUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={nlUrl} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link
			rel="preload"
			href="/fonts/fraunces-variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/source-sans-3-variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Tofleven" />
		<meta property="og:title" content={pageSeo.title} />
		<meta property="og:description" content={pageSeo.description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content={locale === "nl" ? "nl_NL" : "en_GB"} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageSeo.title} />
		<meta name="twitter:description" content={pageSeo.description} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">{shared.skipLink}</a>
		<SiteHeader locale={locale} page={page} />
		<main id="main-content" class="page-main" tabindex="-1">
			<slot />
		</main>
		<SiteFooter locale={locale} />
	</body>
</html>
