---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ContentReview from "../components/ContentReview.astro";
import { content, type Locale, type PageKey } from "../lib/content";
import {
	buildStructuredData,
	type PageMetadata,
} from "../lib/seo";
import "../styles/global.css";

interface Props {
	locale: Locale;
	page?: PageKey;
	metadata: PageMetadata;
}

const { locale, page, metadata } = Astro.props;
const shared = content[locale].shared;
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = metadata.canonicalPath
	? new URL(metadata.canonicalPath, siteBase)
	: null;
const alternates = metadata.localeAlternates
	? {
			nl: new URL(metadata.localeAlternates.nl, siteBase),
			en: new URL(metadata.localeAlternates.en, siteBase),
			xDefault: new URL(metadata.localeAlternates.xDefault, siteBase),
		}
	: null;
const socialImage = metadata.socialImage
	? { ...metadata.socialImage, url: new URL(metadata.socialImage.path, siteBase) }
	: null;
const structuredData = buildStructuredData(metadata, locale, siteBase);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f7f3ec" />
		<meta name="color-scheme" content="light" />
		<meta name="description" content={metadata.description} />
		<meta
			name="robots"
			content={metadata.indexable ? "index, follow" : "noindex, nofollow"}
		/>

		<title>{metadata.title}</title>
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{alternates && (
			<>
				<link rel="alternate" hreflang="nl" href={alternates.nl} />
				<link rel="alternate" hreflang="en" href={alternates.en} />
				<link rel="alternate" hreflang="x-default" href={alternates.xDefault} />
			</>
		)}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link
			rel="preload"
			href="/fonts/fraunces-variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/source-sans-3-variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Tofleven" />
		<meta property="og:title" content={metadata.title} />
		<meta property="og:description" content={metadata.description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:locale" content={locale === "nl" ? "nl_NL" : "en_GB"} />
		{socialImage && (
			<>
				<meta property="og:image" content={socialImage.url} />
				<meta property="og:image:alt" content={socialImage.alt} />
				<meta property="og:image:width" content={String(socialImage.width)} />
				<meta property="og:image:height" content={String(socialImage.height)} />
			</>
		)}
		<meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
		<meta name="twitter:title" content={metadata.title} />
		<meta name="twitter:description" content={metadata.description} />
		{socialImage && (
			<>
				<meta name="twitter:image" content={socialImage.url} />
				<meta name="twitter:image:alt" content={socialImage.alt} />
			</>
		)}
		{structuredData && (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		)}
	</head>
	<body>
		<a class="skip-link" href="#main-content">{shared.skipLink}</a>
		<SiteHeader locale={locale} page={page} />
		<main id="main-content" class="page-main" tabindex="-1">
			<slot />
		</main>
		{page && <ContentReview locale={locale} page={page} />}
		<SiteFooter locale={locale} />
	</body>
</html>
